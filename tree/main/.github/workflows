
name: Cập nhật ngày nghỉ

on:
  schedule:
    - cron: "0 0 25 * *"   # ngày 25 hằng tháng (07:00 giờ VN) - dữ liệu sẵn sàng trước tháng mới
  workflow_dispatch:        # cho phép bấm chạy tay trong tab Actions

permissions:
  contents: write

jobs:
  update:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: Lấy ngày nghỉ và ghi holidays.json
        env:
          CALENDARIFIC_KEY: ${{ secrets.CALENDARIFIC_KEY }}
        run: python scripts/update_holidays.py
      - name: Commit nếu có thay đổi
        run: |
          if [ -n "$(git status --porcelain holidays.json)" ]; then
            git config user.name "github-actions[bot]"
            git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
            git add holidays.json
            git commit -m "Cập nhật ngày nghỉ tự động"
            git push
          else
            echo "Không có thay đổi."
          fi
